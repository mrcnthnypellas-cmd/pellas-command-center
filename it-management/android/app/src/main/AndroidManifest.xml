<?xml version="1.0" encoding="utf-8"?>
<!-- Stand-alone Android app: the whole system runs inside the app, on the phone.
     No INTERNET permission — the app never talks to a server or the cloud. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.pellas.itcommand">
    <application
        android:label="Pellas IT Command"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
