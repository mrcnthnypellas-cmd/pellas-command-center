# ---- Local development (npm run dev on this machine) ----
# Point at a local Postgres, or paste a Neon connection string here too — Neon works
# fine for local dev, not just production.
DATABASE_URL="postgresql://pellas_app:changeme@localhost:5432/pellas_command_center?schema=public"

# ---- Cloud deployment (Vercel + Neon) ----
# In the Vercel project's Environment Variables settings, set DATABASE_URL to Neon's
# POOLED connection string (the one with "-pooler" in the host, used by serverless
# functions), and DIRECT_URL to Neon's DIRECT connection string (used only for
# `prisma migrate deploy`, which needs a non-pooled connection).
# For plain local Postgres (no pooling), just set DIRECT_URL to the same value as
# DATABASE_URL — Prisma requires the env var to exist even when it's redundant.
DIRECT_URL="postgresql://pellas_app:changeme@localhost:5432/pellas_command_center?schema=public"

# NextAuth
# Local: http://localhost:3000
# Vercel: your production URL, e.g. https://pellas-command-center.vercel.app
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string-openssl-rand-base64-32"

# File storage adapter — business logic only ever calls storage() from src/lib/storage,
# never touches these directly, so this is the only place that needs to change.
#   "local": filesystem, dev on this machine only.
#   "s3": S3-compatible bucket — REQUIRED when deployed to Vercel (serverless functions
#          have no persistent local disk). Cloudflare R2 works great here (S3-compatible,
#          free egress).
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="./storage/uploads"

# S3-compatible storage (used only when STORAGE_DRIVER=s3)
# For Cloudflare R2: S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com", S3_REGION="auto"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Transactional email provider (integration point only, no live account required for dev)
EMAIL_DRIVER="console"
RESEND_API_KEY=""
EMAIL_FROM="no-reply@pellas.local"
