// Pellas Command Center — core data model.
// Every company-scoped table carries a required, indexed companyId FK.
// All reads/writes to these tables must go through src/lib/scope.ts (withCompanyScope),
// never a hand-rolled `where: { companyId }`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Only needed for Neon-style pooled connections: `prisma migrate` requires a direct
  // (non-pooled) connection. Falls back to DATABASE_URL when DIRECT_URL is unset, so
  // this is a no-op for plain local Postgres.
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  HR_ADMIN
  IT_ADMIN
  EMPLOYEE
  CLIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum AttendanceType {
  IN
  OUT
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  PAID
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  IN_REPAIR
  RETIRED
  LOST
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum AssetHistoryAction {
  ASSIGN
  TRANSFER
  RETURN
  REPAIR
  AUDIT
  RETIRE
}

enum DocumentVisibility {
  COMPANY_ALL
  ROLE_RESTRICTED
  PRIVATE
}

enum CalendarSource {
  MANUAL
  EXCEL_IMPORT
}

enum CalendarStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

enum NotificationType {
  PAYROLL_DAY
  DEADLINE_REMINDER
  TIME_IN
  TIME_OUT
  NEW_PAYSLIP
  ASSET_ASSIGNED
  ASSET_RETURNED
  WARRANTY_EXPIRING
  LOW_INVENTORY
  NEW_DOCUMENT
  TRANSACTION_UPDATE
  GENERIC
}

// ---------- Platform ----------

model Company {
  id        String   @id @default(cuid())
  name      String
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Login geofence — when enabled, EMPLOYEE and HR_ADMIN users of this company
  // may only sign in from within geofenceRadiusMeters of (geofenceLat, geofenceLng).
  geofenceEnabled      Boolean @default(false)
  geofenceLat          Float?
  geofenceLng          Float?
  geofenceRadiusMeters Int?

  users           User[]
  employees       Employee[]
  attendances     Attendance[]
  payrolls        Payroll[]
  payslips        Payslip[]
  assets          Asset[]
  assetHistories  AssetHistory[]
  documentFolders DocumentFolder[]
  documents       DocumentVersion[]
  calendarEvents  CalendarEvent[]
  clients         Client[]
  transactions    Transaction[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  documentsRoot   Document[]
  emailLogs       EmailLog[]
  announcements   Announcement[]
}

model User {
  id           String     @id @default(cuid())
  companyId    String? // nullable only for SUPER_ADMIN
  company      Company?   @relation(fields: [companyId], references: [id])
  role         Role
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  employee              Employee?
  client                Client?
  notifications         Notification[]
  auditLogs             AuditLog[]           @relation("AuditLogActor")
  uploadedDocuments     Document[]           @relation("DocumentUploader")
  uploadedVersions      DocumentVersion[]    @relation("VersionUploader")
  createdFolders        DocumentFolder[]     @relation("FolderCreator")
  createdCalendarEvents CalendarEvent[]      @relation("CalendarCreator")
  processedPayrolls     Payroll[]            @relation("PayrollProcessor")
  assignedTransactions  Transaction[]        @relation("TransactionAssignee")
  assetHistoryActions   AssetHistory[]       @relation("AssetHistoryActor")
  emailLogs             EmailLog[]
  platformSettingUpdates PlatformSetting[]
  createdAnnouncements  Announcement[]

  @@index([companyId])
  @@index([role])
}

// ---------- HR / Employee ----------

model Employee {
  id               String           @id @default(cuid())
  companyId        String
  company          Company          @relation(fields: [companyId], references: [id])
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode     String
  department       String
  position         String
  hireDate         DateTime
  employmentStatus EmploymentStatus @default(ACTIVE)

  // Confidential — HR Admin / Company Admin visibility only. IT Admin must never see these.
  salary          Decimal? @db.Decimal(12, 2)
  sssNumber       String?
  philhealthNumber String?
  pagibigNumber   String?
  tinNumber       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendances     Attendance[]
  payrolls        Payroll[]
  payslips        Payslip[]
  assignedAssets  Asset[]            @relation("AssetAssignee")
  assetHistoryFrom AssetHistory[]    @relation("AssetHistoryFrom")
  assetHistoryTo   AssetHistory[]    @relation("AssetHistoryTo")

  @@unique([companyId, employeeCode])
  @@index([companyId])
}

model Attendance {
  id         String         @id @default(cuid())
  companyId  String
  company    Company        @relation(fields: [companyId], references: [id])
  employeeId String
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  timestamp  DateTime       @default(now())
  type       AttendanceType
  latitude   Float?
  longitude  Float?
  device     String?
  source     String         @default("web")
  createdAt  DateTime       @default(now())

  @@index([companyId])
  @@index([employeeId, timestamp])
}

// ---------- Payroll ----------

model Payroll {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payPeriodStart  DateTime
  payPeriodEnd    DateTime
  gross           Decimal       @db.Decimal(12, 2)
  // Statutory deductions are entered manually per payslip (no auto-calculation) — see project decision.
  sssDeduction       Decimal    @default(0) @db.Decimal(12, 2)
  philhealthDeduction Decimal   @default(0) @db.Decimal(12, 2)
  pagibigDeduction    Decimal   @default(0) @db.Decimal(12, 2)
  taxDeduction        Decimal   @default(0) @db.Decimal(12, 2)
  otherDeductions     Decimal   @default(0) @db.Decimal(12, 2)
  otherDeductionsNote String?
  net                 Decimal   @db.Decimal(12, 2)
  status              PayrollStatus @default(DRAFT)
  processedByUserId   String?
  processedByUser     User?     @relation("PayrollProcessor", fields: [processedByUserId], references: [id])
  processedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  payslip Payslip?

  @@index([companyId])
  @@index([employeeId, payPeriodStart])
}

model Payslip {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  payrollId  String   @unique
  payroll    Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  pdfStoragePath String?
  issuedAt   DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([companyId])
  @@index([employeeId])
}

// ---------- IT Assets ----------

model Asset {
  id                 String         @id @default(cuid())
  companyId          String
  company            Company        @relation(fields: [companyId], references: [id])
  assetTag           String
  qrCodeValue        String?
  serialNumber       String?
  brand              String?
  model              String?
  category           String
  purchaseDate       DateTime?
  cost               Decimal?       @db.Decimal(12, 2)
  supplier           String?
  warrantyExpiresAt  DateTime?
  contractInfo       String?
  condition          AssetCondition @default(GOOD)
  status             AssetStatus    @default(AVAILABLE)
  location           String?
  assignedEmployeeId String?
  assignedEmployee   Employee?      @relation("AssetAssignee", fields: [assignedEmployeeId], references: [id])
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  history AssetHistory[]

  @@unique([companyId, assetTag])
  @@index([companyId])
  @@index([assignedEmployeeId])
}

model AssetHistory {
  id             String             @id @default(cuid())
  companyId      String
  company        Company            @relation(fields: [companyId], references: [id])
  assetId        String
  asset          Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  action         AssetHistoryAction
  fromEmployeeId String?
  fromEmployee   Employee?          @relation("AssetHistoryFrom", fields: [fromEmployeeId], references: [id])
  toEmployeeId   String?
  toEmployee     Employee?          @relation("AssetHistoryTo", fields: [toEmployeeId], references: [id])
  performedByUserId String
  performedByUser   User            @relation("AssetHistoryActor", fields: [performedByUserId], references: [id])
  notes          String?
  timestamp      DateTime           @default(now())

  @@index([companyId])
  @@index([assetId, timestamp])
}

// ---------- Documents ----------

model DocumentFolder {
  id             String             @id @default(cuid())
  companyId      String
  company        Company            @relation(fields: [companyId], references: [id])
  name           String
  parentFolderId String?
  parentFolder   DocumentFolder?    @relation("FolderTree", fields: [parentFolderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children       DocumentFolder[]   @relation("FolderTree")
  visibility     DocumentVisibility @default(COMPANY_ALL)
  allowedRoles   Role[]             @default([])
  createdByUserId String
  createdByUser   User              @relation("FolderCreator", fields: [createdByUserId], references: [id])
  isArchived     Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  documents Document[]

  @@index([companyId])
  @@index([parentFolderId])
}

model Document {
  id              String            @id @default(cuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id])
  folderId        String?
  folder          DocumentFolder?   @relation(fields: [folderId], references: [id])
  filename        String
  mimeType        String
  visibility      DocumentVisibility @default(COMPANY_ALL)
  allowedRoles    Role[]            @default([])
  uploadedByUserId String
  uploadedByUser   User             @relation("DocumentUploader", fields: [uploadedByUserId], references: [id])
  isArchived      Boolean           @default(false)
  currentVersion  Int               @default(1)
  transactionId   String?
  transaction     Transaction?      @relation(fields: [transactionId], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  versions DocumentVersion[]

  @@index([companyId])
  @@index([folderId])
  @@index([transactionId])
}

model DocumentVersion {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id])
  documentId       String
  document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version          Int
  storagePath      String
  sizeBytes        Int
  uploadedByUserId String
  uploadedByUser   User     @relation("VersionUploader", fields: [uploadedByUserId], references: [id])
  createdAt        DateTime @default(now())

  @@unique([documentId, version])
  @@index([companyId])
}

// ---------- Calendar ----------

model CalendarEvent {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id])
  title           String
  description     String?
  department      String?
  startAt         DateTime
  endAt           DateTime?
  isDeadline      Boolean        @default(false)
  location        String?
  status          CalendarStatus @default(SCHEDULED)
  source          CalendarSource @default(MANUAL)
  createdByUserId String
  createdByUser   User           @relation("CalendarCreator", fields: [createdByUserId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([companyId])
  @@index([companyId, startAt])
}

// ---------- Clients / Transactions ----------

model Client {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientCode  String
  businessName String?
  contactInfo Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions Transaction[]

  @@unique([companyId, clientCode])
  @@index([companyId])
}

model Transaction {
  id                String            @id @default(cuid())
  companyId         String
  company           Company           @relation(fields: [companyId], references: [id])
  clientId          String
  client            Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  transactionCode   String
  service           String
  amount            Decimal           @db.Decimal(12, 2)
  status            TransactionStatus @default(PENDING)
  assignedStaffUserId String?
  assignedStaffUser   User?           @relation("TransactionAssignee", fields: [assignedStaffUserId], references: [id])
  remarks           String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  documents Document[]

  @@unique([companyId, transactionCode])
  @@index([companyId])
  @@index([clientId])
}

// ---------- Notifications / Audit ----------

model Notification {
  id        String            @id @default(cuid())
  companyId String
  company   Company           @relation(fields: [companyId], references: [id])
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  payload   Json              @default("{}")
  isRead    Boolean           @default(false)
  createdAt DateTime          @default(now())

  @@index([companyId])
  @@index([userId, isRead])
}

// AuditLog is intentionally exempt from the required-companyId rule (per spec §4) since
// Super Admin actions may span companies; companyId is kept nullable for filtering when known.
model AuditLog {
  id            String   @id @default(cuid())
  companyId     String?
  company       Company? @relation(fields: [companyId], references: [id])
  userId        String?
  user          User?    @relation("AuditLogActor", fields: [userId], references: [id])
  action        String
  entityType    String
  entityId      String?
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([companyId])
  @@index([entityType, entityId])
  @@index([userId])
}

// ---------- Email Center ----------
// Log of messages actually sent through the provider interface in src/lib/email —
// this app never simulates itself as a mail server or stores an inbound mailbox
// (spec §5.12); there is no inbox/receiving capability.
model EmailLog {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  sentByUserId String
  sentByUser   User     @relation(fields: [sentByUserId], references: [id])
  toAddress    String
  subject      String
  bodyHtml     String
  providerId   String?
  status       String   @default("sent")
  createdAt    DateTime @default(now())

  @@index([companyId])
  @@index([sentByUserId])
}

// ---------- Platform Settings ----------
// Single-row table (fixed id) for platform-wide branding — currently just the login
// page background image. Super Admin only. Deliberately not per-company: the login
// page is shared by every company before anyone has authenticated, so there is no
// company context yet to branch on.
model PlatformSetting {
  id                        String   @id @default("singleton")
  loginBackgroundStorageKey String?
  // IANA timezone name (e.g. "Asia/Manila") used for the live clock shown on every
  // dashboard header. Defaults to Philippine time since that's this app's business
  // context — configurable here rather than derived from wherever the server happens
  // to be hosted (that mismatch caused a real date-off-by-one bug earlier).
  timezone                  String   @default("Asia/Manila")
  updatedByUserId           String?
  updatedByUser             User?    @relation(fields: [updatedByUserId], references: [id])
  updatedAt                 DateTime @updatedAt
}

// ---------- Announcements ----------
// companyId null = platform-wide, posted by Super Admin, shown on every company's
// dashboard. companyId set = posted by that company's Company Admin, shown only to
// that company. The dashboard shows the single most recent active announcement
// visible to the caller (platform-wide ones plus their own company's).
model Announcement {
  id              String   @id @default(cuid())
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id])
  title           String
  body            String
  isActive        Boolean  @default(true)
  createdByUserId String
  createdByUser   User     @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  @@index([companyId, isActive])
}
