# Hotel Booking & Management System — LOCAL ONLY configuration
# Copy this file to .env.local and adjust if you want.
# Nothing here talks to the internet — everything runs on your own device.

# Demo admin login (development only — never use for a real deployment)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Random string used to sign the admin session cookie.
# Any long random text works; the exact value doesn't matter for local use.
SESSION_SECRET=change-this-local-secret-please
